---
// src/components/Stats.astro
---

<section class="bg-gray-50 border-b border-gray-200 relative z-20">
  <div class="max-w-7xl mx-auto px-6 py-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div>
        <p class="text-3xl font-extrabold text-brand-blue">+10</p>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-700 mt-1">OBRAS ENTREGADAS</p>
      </div>
      <div>
        <p class="text-3xl font-extrabold text-brand-blue">100%</p>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-700 mt-1">CUMPLIMIENTO DE PLAZOS</p>
      </div>
      <div>
        <p class="text-3xl font-extrabold text-brand-blue">+5</p>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-700 mt-1">AÑOS DE TRAYECTORIA</p>
      </div>
      <div>
        <p class="text-3xl font-extrabold text-brand-blue">ISO</p>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-700 mt-1">9001 & 45001 CERTIFICADOS</p>
      </div>
    </div>
  </div>
</section>