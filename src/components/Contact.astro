---
// src/components/Contact.astro
---

<section id="contacto" class="py-20 bg-gradient-to-br from-brand-graphite via-[#111827] to-brand-graphite text-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Información de Contacto (Izquierda) -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-orange/20 text-brand-orange text-xs font-bold uppercase tracking-wider">
          Iniciemos su próximo hito constructivo
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          ¿Listo para llevar su proyecto al siguiente nivel de ingeniería?
        </h2>
        <p class="text-gray-300 text-base leading-relaxed">
          Nuestro equipo técnico evalúa sus especificaciones y le entrega una cotización pormenorizada con cronograma de obra y factibilidad presupuestaria en menos de 48 horas.
        </p>
        
        <div class="space-y-4 pt-4 border-t border-gray-700">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-brand-blue flex items-center justify-center text-white shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-400">Atención Directa</p>
              <p class="text-sm font-semibold text-white">+54 (11) 4892-3000 / +54 9 11 2345-6789</p>
            </div>
          </div>
          
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-brand-blue flex items-center justify-center text-white shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-400">Correo Corporativo</p>
              <p class="text-sm font-semibold text-white">contacto@llarek-ingenieria.com</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Formulario Rápido de Cotización (Derecha) -->
      <div class="lg:col-span-6 bg-brand-graphite p-8 rounded-2xl border border-gray-700 shadow-2xl">
        <h3 class="text-xl font-bold text-white mb-2">Solicitar Presupuesto</h3>
        <p class="text-xs text-gray-400 mb-6">Complete los datos y un ingeniero especialista se contactará a la brevedad.</p>
        
        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Gracias por su solicitud. Un asesor técnico de LLAREK se comunicará en breve.');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-gray-300 mb-1">Nombre Completo</label>
              <input type="text" required placeholder="Ing. Carlos Mendoza" class="w-full bg-[#111827] border border-gray-600 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-orange" />
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-300 mb-1">Teléfono / Celular</label>
              <input type="tel" required placeholder="+54 9 11 ..." class="w-full bg-[#111827] border border-gray-600 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-orange" />
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-300 mb-1">Correo Electrónico</label>
            <input type="email" required placeholder="carlos@empresa.com" class="w-full bg-[#111827] border border-gray-600 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-orange" />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-300 mb-1">Tipo de Servicio Requerido</label>
            <select class="w-full bg-[#111827] border border-gray-600 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand-orange">
              <option>Ingeniería y Cálculo Estructural</option>
              <option>Construcción y Obra Civil</option>
              <option>Remodelación Corporativa / Fit-Out</option>
              <option>Consultoría Integral de Proyecto</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-300 mb-1">Descripción Breve de la Obra</label>
            <textarea rows="3" placeholder="Detalle alcance estimado, ubicación y plazos previstos..." class="w-full bg-[#111827] border border-gray-600 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-orange"></textarea>
          </div>
          <button type="submit" class="w-full py-3.5 bg-brand-orange hover:bg-brand-orange-hover text-white font-bold rounded-lg shadow-lg hover:shadow-orange-500/30 transition-all text-sm uppercase tracking-wide">
            Enviar Solicitud de Cotización
          </button>
        </form>
      </div>

    </div>
  </div>
</section>