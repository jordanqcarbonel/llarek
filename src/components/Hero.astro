---
// src/components/Hero.astro
---

<section id="inicio" class="relative min-h-[550px] sm:min-h-[600px] md:min-h-[650px] flex items-center bg-gray-950 text-white overflow-hidden py-24 sm:py-32">
  
  <!-- CONTENEDOR DEL CARRUSEL (Imágenes de fondo) -->
  <div class="absolute inset-0 z-0">
    <!-- Imagen 1 (Activa por defecto) -->
    <div class="slide absolute inset-0 opacity-100 transition-opacity duration-1000 ease-in-out">
      <img 
        alt="LLAREK Obras y Proyectos de Ingeniería" 
        class="w-full h-full object-cover object-center" 
        src="/carrousel-1.jpg"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-gray-950/95 via-gray-950/80 to-transparent/40"></div>
    </div>

    <!-- Imagen 2 -->
    <div class="slide absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out">
      <img 
        alt="Infraestructura y Obras Industriales" 
        class="w-full h-full object-cover object-center" 
        src="/carrousel-2.jpg"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-gray-950/95 via-gray-950/80 to-transparent/40"></div>
    </div>

    <!-- Imagen 3 -->
    <div class="slide absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out">
      <img 
        alt="Acondicionamiento y Habilitación Comercial" 
        class="w-full h-full object-cover object-center" 
        src="/carrousel-3.jpg"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-gray-950/95 via-gray-950/80 to-transparent/40"></div>
    </div>
  </div>

  <!-- CONTENIDO DE TEXTO (Siempre en primer plano) -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-2xl lg:max-w-3xl text-left flex flex-col items-start mt-8 sm:mt-12">
      
      <!-- Insignia Corporativa Superior -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mb-5 text-xs sm:text-sm font-medium tracking-wide text-gray-200">
        <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse"></span>
        Líderes en soluciones de ingeniería civil y arquitectónica
      </div>
      
      <!-- H1 Marca -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-2">
        LLAREK
      </h1>
      
      <!-- H2 Eslogan -->
      <h2 class="text-xl sm:text-2xl md:text-3xl font-light text-gray-100 leading-snug mb-5">
        Ingeniería que <span class="font-bold text-brand-orange">transforma</span> <span class="font-bold text-white">espacios</span>
      </h2>
      
      <!-- Párrafo Descriptivo -->
      <p class="text-gray-300 text-sm sm:text-base md:text-lg max-w-2xl mb-8 font-normal leading-relaxed">
        Diseñamos, planificamos y ejecutamos proyectos de alta envergadura con rigor técnico, sostenibilidad y acabados de vanguardia para el sector corporativo, industrial e inmobiliario.
      </p>
      
      <!-- Botones de Acción Alineados a la Izquierda -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a href="#contacto" class="inline-flex items-center justify-center px-7 py-3.5 bg-brand-orange hover:bg-brand-orange-hover text-white text-sm sm:text-base font-bold rounded-lg shadow-lg shadow-orange-950/30 hover:shadow-orange-600/30 transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Solicitar Cotización
        </a>
        <a href="#servicios" class="inline-flex items-center justify-center px-7 py-3.5 bg-transparent hover:bg-white/10 text-white text-sm sm:text-base font-semibold rounded-lg border-2 border-white backdrop-blur-sm transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
          Ver Servicios
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- CONTROLES DEL CARRUSEL (Flechas e indicadores) -->
  <div class="absolute inset-x-0 bottom-6 z-20 flex justify-between items-center px-4 sm:px-8 max-w-7xl mx-auto pointer-events-none">
    <!-- Indicadores de Posición (Puntitos) -->
    <div class="flex gap-2 pointer-events-auto">
      <button class="dot w-8 h-1.5 rounded-full bg-white opacity-100 transition-all duration-300" aria-label="Slide 1"></button>
      <button class="dot w-3 h-1.5 rounded-full bg-white/40 hover:bg-white/75 transition-all duration-300" aria-label="Slide 2"></button>
      <button class="dot w-3 h-1.5 rounded-full bg-white/40 hover:bg-white/75 transition-all duration-300" aria-label="Slide 3"></button>
    </div>

    <!-- Botones de Navegación -->
    <div class="flex gap-2 pointer-events-auto">
      <button id="prev-slide" class="w-10 h-10 rounded-full border border-white/20 bg-black/10 backdrop-blur-md hover:bg-brand-orange hover:border-brand-orange text-white flex items-center justify-center transition-all active:scale-90" aria-label="Anterior">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button id="next-slide" class="w-10 h-10 rounded-full border border-white/20 bg-black/10 backdrop-blur-md hover:bg-brand-orange hover:border-brand-orange text-white flex items-center justify-center transition-all active:scale-90" aria-label="Siguiente">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<!-- LÓGICA DEL CARRUSEL (Inyectada al final de la carga para no bloquear) -->
<script>
  function setupCarrousel() {
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    const btnPrev = document.getElementById('prev-slide');
    const btnNext = document.getElementById('next-slide');

    if (!slides.length || !dots.length) return;

    let currentIndex = 0;
    let timer: NodeJS.Timeout;

    function showSlide(index: number) {
      // Remover activas anteriores
      slides[currentIndex].classList.replace('opacity-100', 'opacity-0');
      dots[currentIndex].classList.replace('bg-white', 'bg-white/40');
      dots[currentIndex].classList.replace('w-8', 'w-3');

      // Actualizar índice
      currentIndex = (index + slides.length) % slides.length;

      // Activar nueva slide
      slides[currentIndex].classList.replace('opacity-0', 'opacity-100');
      dots[currentIndex].classList.replace('bg-white/40', 'bg-white');
      dots[currentIndex].classList.add('w-8');
      
      resetTimer();
    }

    function next() { showSlide(currentIndex + 1); }
    function prev() { showSlide(currentIndex - 1); }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(next, 5000); // Cambio automático cada 5 segundos
    }

    // Eventos Click
    btnNext?.addEventListener('click', next);
    btnPrev?.addEventListener('click', prev);

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => showSlide(i));
    });

    // Iniciar temporizador
    resetTimer();
  }

  // Compatibilidad con transiciones de Astro
  document.addEventListener('DOMContentLoaded', setupCarrousel);
</script>